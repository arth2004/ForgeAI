# ==============================================================================
# Forge AI — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database (Postgres 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=forgeai
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/forgeai

# Redis (Cache, Rate Limits & ARQ Job Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography
# JWT secret for signing authentication tokens (min 32 characters)
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-forgeai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256-GCM 32-byte key (64 hex characters) for encrypting credentials at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub App Integration (Phase 2)
# Create a GitHub App with permissions: Contents: Read, Metadata: Read (0 write permissions)
GITHUB_APP_ID=
GITHUB_APP_SLUG=forge-ai-app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback

# Phase 3 Embedding & Indexing Settings (768-dimensional Vector Space)
EMBEDDING_PROVIDER=google
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Phase 4 Agent Foundation & LLM Provider Settings
# Supported providers: google, openai, groq, openai_compatible, mock
AGENT_DEFAULT_PROVIDER=google
AGENT_GEMINI_MODEL=gemini-3.1-pro-preview
AGENT_OPENAI_MODEL=gpt-4o
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096
AGENT_TIMEOUT_SECONDS=60.0

# Groq Provider (recommended for higher free usage)
# Model limits for openai/gpt-oss-120b: 30 RPM, 1,000 RPD, 8K TPM, 200K TPD
# (14,400 RPD applies to lighter models like Llama 3.1 8B)
# Get key: https://console.groq.com/keys (no credit card required)
# To use: set AGENT_DEFAULT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Generic OpenAI-compatible provider (NVIDIA NIM, Cerebras, OpenRouter, etc.)
# To use: set AGENT_DEFAULT_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# ------------------------------------------------------------------------------
# Ingestion Workload Profiles & Architectural Limits
# ------------------------------------------------------------------------------
# The ingestion engine uses streaming HTTP extraction, AST semantic chunking,
# SHA-256 diff caching, and pgvector HNSW indexing across all workloads.
#
# Profile A: Development / Demo Workload (Recommended for Gemini Free Tier)
#   - Recommended test repos: Clean focused repositories (3–30 files, e.g. Weather-App,
#     small webapps, microservices) generating ~5–50 chunks.
#   - Fits within free-tier rate limits (15 RPM / daily quotas) with fast sub-second indexing.
#   - Incremental commits re-index only changed files with SHA-256 content deduplication.
#
# Profile B: Production / Enterprise Workload
#   - Large codebases with hundreds of files and multi-megabyte source trees.
#   - Standard paid Google Gemini or OpenAI quotas supporting high-throughput batching.
#
# Configurable Limits (bytes):
MAX_FILE_SIZE_BYTES=1048576       # Default: 1 MB per source file
MAX_REPO_SIZE_BYTES=524288000     # Default: 500 MB maximum repository tarball stream
MAX_CHUNKS_PER_EMBED_BATCH=100    # Sub-batch embedding chunk size (1-100)

# Frontend URL
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
