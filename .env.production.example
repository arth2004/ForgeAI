# ==============================================================================
# Forge AI — Production Environment Template (.env.production)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.production.example .env
# 2. Generate cryptographically strong secrets:
#    - JWT_SECRET: openssl rand -base64 48
#    - ENCRYPTION_KEY: openssl rand -hex 32
#    - GITHUB_WEBHOOK_SECRET: openssl rand -hex 32
# 3. Populate your production domain names and database credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Networking & Ingress
API_PORT=8000
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com"]
FRONTEND_URL=https://app.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Production Database (Managed PostgreSQL 16 + pgvector recommended, e.g. Supabase, AWS RDS, Neon)
POSTGRES_USER=forgeai_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
POSTGRES_DB=forgeai
DATABASE_URL=postgresql+asyncpg://forgeai_admin:REPLACE_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/forgeai

# Production Redis (Managed Redis 7 recommended, e.g. Upstash, AWS ElastiCache)
REDIS_URL=redis://redis:6379/0

# Production Security & Encryption (CRITICAL: Server will fail to start if defaults are used)
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AES-256-GCM 32-byte key (64 hex characters) for encrypting GitHub tokens & credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING_FOR_AES_256_GCM_ENCRYPTION_KEY

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_SLUG=your-org-forge-ai
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_STRONG_GITHUB_WEBHOOK_SECRET
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_REDIRECT_URI=https://api.yourdomain.com/api/v1/github/callback

# Phase 3 Embedding & Indexing Settings
EMBEDDING_PROVIDER=google
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# Phase 4 Agent Foundation & LLM Provider Settings
AGENT_DEFAULT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ingestion Limits
MAX_FILE_SIZE_BYTES=1048576
MAX_REPO_SIZE_BYTES=524288000
MAX_CHUNKS_PER_EMBED_BATCH=100
WEB_CONCURRENCY=4
